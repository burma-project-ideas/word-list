@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<a class="skip-link" href="@(NavigationManager.Uri.Split('#')[0] + "#main-content")">Skip to content</a>
<div class="app-shell">
    <header class="site-header page-width">
        <a href="/" class="wordmark" aria-label="Word List home">
            <img src="logo.svg" alt="" width="34" height="34" />
            <span>word<span class="text-muted-foreground">list</span><span class="brand-stop">.</span></span>
        </a>
        <PrestigeNavbarPill />
        <div class="header-actions">
            <a class="source-link" href="https://github.com/burma-project-ideas/word-list" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a>
            <ThemeToggle />
        </div>
    </header>
    <main id="main-content" tabindex="-1">@Body</main>
    <footer class="site-footer page-width">
        <div><a href="https://github.com/burma-project-ideas">Burma Project Ideas</a><p>Made for the Myanmar language community.</p></div>
        <div class="footer-credits">
            <span>Wordlists by <a href="https://github.com/kanaung/wordlists">Kanaung</a> · App by <a href="https://github.com/sannlynnhtun-coding">Sann Lynn Htun</a></span>
            <span>UI adapted from <a href="https://prestigeui.com/">Prestige UI</a></span>
        </div>
    </footer>
</div>
