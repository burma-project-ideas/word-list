<div class="page-width dictionary-page">
    <section class="dictionary-hero">
        <div class="hero-copy">
            <p class="eyebrow">A little closer to our language</p>
            <h1 class="reveal-text">Every word.<br /><span class="text-muted-foreground">A new beginning.</span></h1>
            <p class="hero-description">Explore Myanmar words, find the spelling you need,<br class="desktop-break" /> and make room for better writing.</p>
            <p class="myanmar hero-burmese" lang="my">မြန်မာစကားလုံးတွေကို အတူတူ လေ့လာကြမယ်။</p>
        </div>
        <div class="letter-specimen" aria-hidden="true">
            <span class="specimen-label">THE MYANMAR ALPHABET</span>
            <span class="specimen-letter" lang="my">က</span>
            <div class="specimen-caption"><span>ကကြီး</span><span>Where it begins.</span></div>
        </div>
    </section>

    <section class="search-workspace" aria-labelledby="search-heading">
        <div class="workspace-heading"><h2 id="search-heading">Find your word</h2><span>Myanmar word search</span></div>
        <div class="search-panel">
            <label for="word-search" class="sr-only">Search Myanmar words by their first letters</label>
            <div class="search-field">
                <span class="search-symbol" aria-hidden="true">⌕</span>
                <input id="word-search" type="search" autocomplete="off" spellcheck="false" lang="my"
                       placeholder="စကားလုံး ရှာဖွေပါ..." @bind="SearchText" @bind:event="oninput" @bind:after="HandleSearch" />
            </div>
            <PrestigeShineButton OnClick="HandleSearch" Disabled="IsLoading">@(IsLoading ? "Searching…" : "Search words") <span aria-hidden="true">↗</span></PrestigeShineButton>
        </div>
        <div class="search-examples"><span>Start with</span>
            @foreach (var suggestion in new[] { "က", "ခ", "မြန်မာ", "အဘိဓာန်", "စာလုံးပေါင်း" })
            {
                <button type="button" lang="my" class="example-chip myanmar" @onclick="() => SetSearchText(suggestion)">@suggestion</button>
            }
        </div>
        <div class="results-region" aria-live="polite" aria-busy="@IsLoading.ToString().ToLowerInvariant()">
            @if (IsLoading)
            {
                <div class="empty-state"><span class="loading-spinner" aria-hidden="true"></span><h3>Finding your words</h3><p>Loading the Myanmar wordlists. This can take a moment on your first search.</p></div>
            }
            else if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <div class="results-heading"><h3>Words beginning with <span class="myanmar" lang="my">“@SearchText”</span></h3><span>@Results.Count results · up to 50 shown</span></div>
                @if (Results.Any())
                {
                    <div class="word-grid">
                        @foreach (var word in Results)
                        {
                            <button type="button" class="word-result" @onclick="() => SelectWord(word)"><span lang="my" class="myanmar">@word</span><span class="word-arrow" aria-hidden="true">↗</span></button>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state"><h3>No words found</h3><p>Try a shorter beginning, or another Myanmar letter.</p></div>
                }
            }
            else
            {
                <div class="welcome-state"><span class="welcome-letter myanmar" lang="my" aria-hidden="true">အ</span><div><h3>A word is a good place to start.</h3><p>Type the first letters of a Myanmar word. We’ll find matching spellings from the Kanaung wordlists.</p></div><span class="welcome-note">Words, without definitions.</span></div>
            }
        </div>
    </section>
    <section class="writing-invitation"><div><p class="eyebrow">From finding to writing</p><h2>A second look at your spelling.</h2><p>Write in Myanmar, spot unfamiliar spellings, and explore suggestions.</p></div><a href="/spell-check" class="secondary-button">Open spell checker <span aria-hidden="true">↗</span></a></section>
</div>

@code {
    [Inject] public DictionaryLoaderService DictionaryLoader { get; set; } = default!;
    
    private string SearchText { get; set; } = "";
    private List<string> Results { get; set; } = new();
    private bool IsLoading { get; set; } = false;

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            Results.Clear();
            return;
        }

        IsLoading = true;
        try
        {
            Results = await DictionaryLoader.SearchWordsAsync(SearchText);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectWord(string word)
    {
        SearchText = word;
        await HandleSearch();
    }

    private async Task SetSearchText(string text)
    {
        SearchText = text;
        await HandleSearch();
    }
}
