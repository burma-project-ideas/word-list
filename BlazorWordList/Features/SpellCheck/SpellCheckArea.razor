@using BlazorWordList.Features.SpellCheck
@inject SpellCheckService SpellCheckService
@inject DictionaryLoaderService DictionaryLoader
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="page-width spell-page">
    <div class="spell-heading"><p class="eyebrow">A little care for every sentence</p><h1 class="reveal-text">Write with <span class="text-muted-foreground">confidence.</span></h1><p>Check Myanmar spellings as you write. Your text stays in your browser.</p></div>
    <div class="editor-layout">
        <section class="editor-panel" aria-labelledby="editor-heading">
            <div class="editor-toolbar"><div><h2 id="editor-heading">Your writing</h2><span class="editor-status" role="status">@(_isDictionaryLoaded ? "Dictionary ready" : "Loading wordlists…")</span></div><div class="editor-actions"><button type="button" class="quiet-button" @onclick="ClearText">Clear</button><PrestigeShineButton OnClick="ExportText" Disabled="@(!_isDictionaryLoaded)">Save .txt <span aria-hidden="true">↓</span></PrestigeShineButton></div></div>
            <label for="@_editorId" class="sr-only">Myanmar text to check</label>
            <div id="@_editorId" @ref="_editorContainer" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Myanmar text to check" aria-describedby="editor-help" lang="my" spellcheck="false" @oninput="HandleInput" class="writing-editor myanmar" data-placeholder="ဒီနေရာမှာ စာရိုက်ပါ…"></div>
            <div class="editor-bottom"><span>@_wordCount words <span aria-hidden="true">·</span> @_charCount characters</span><span>Checked on your device</span></div>
        </section>
        <aside class="writing-guide" aria-labelledby="guide-heading">
            <span class="guide-glyph myanmar" aria-hidden="true" lang="my">စာ</span><h2 id="guide-heading">A helpful second look.</h2><p id="editor-help">Words with a <span class="sample-squiggle">red underline</span> aren’t in the wordlist. Click or focus one and press Enter to see suggestions.</p>
            <ol><li>Write or paste your Myanmar text.</li><li>Choose a suggestion to replace a word.</li><li>Save your writing as a text file.</li></ol>
            <div class="guide-note"><h3>Language has more to say.</h3><p>A missing word isn’t always a mistake. This tool checks spellings against a wordlist; it doesn’t check grammar or separate unspaced Myanmar sentences.</p></div>
            <a href="/" class="text-link">Look up a word instead <span aria-hidden="true">↗</span></a>
        </aside>
    </div>
    @if (_showPopup)
    {
        <div class="suggestion-popover" role="dialog" aria-label="Spelling suggestions" @onkeydown="HandleSuggestionKey" style="left: @(Math.Clamp(_popupLeft, 8, 10000).ToString(System.Globalization.CultureInfo.InvariantCulture))px; top: @(_popupTop.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
            <div class="suggestion-heading"><span>Suggestions</span><button type="button" class="quiet-button" @onclick="CloseSuggestions" aria-label="Close suggestions">×</button></div>
            @if (_suggestions.Any())
            {
                @foreach (var suggestion in _suggestions)
                {
                    <button type="button" lang="my" class="suggestion-option myanmar" @onclick="() => ApplySuggestion(suggestion)">@suggestion <span aria-hidden="true">↵</span></button>
                }
            }
            else
            {
                <p class="suggestion-empty">No close matches. You can keep your spelling or look it up in the dictionary.</p>
            }
        </div>
    }
</div>

@code {
    private async Task HandleSuggestionKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseSuggestions();
    }

    private async Task CloseSuggestions()
    {
        HideSuggestions();
        await _editorContainer.FocusAsync();
    }

    private DotNetObjectReference<SpellCheckArea>? _dotNetReference;
    public void Dispose() { _debounceTimer?.Dispose(); _dotNetReference?.Dispose(); }

    private ElementReference _editorContainer;
    private bool _isInitialized = false;
    private bool _isDictionaryLoaded = false;
    private string _currentText = "";
    private int _wordCount = 0;
    private int _charCount = 0;
    private List<string> _suggestions = new();
    private string _selectedWord = "";
    
    private bool _showPopup = false;
    private double _popupLeft = 0;
    private double _popupTop = 0;

    protected override async Task OnInitializedAsync()
    {
        _isInitialized = true;
        
        // Background loading of dictionary
        var words = await DictionaryLoader.LoadAllWordsAsync();
        SpellCheckService.Initialize(words);
        _isDictionaryLoaded = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isInitialized)
        {
            await JSRuntime.InvokeVoidAsync("spellCheck.initEditor", _editorId, _dotNetReference = DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void ShowSuggestions(string word, double left, double top)
    {
        _selectedWord = word;
        _suggestions = SpellCheckService.GetSuggestions(word);
        _popupLeft = left;
        _popupTop = top;
        _showPopup = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void HideSuggestions()
    {
        _showPopup = false;
        StateHasChanged();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        _currentText = await JSRuntime.InvokeAsync<string>("eval", $"document.getElementById('{_editorId}').innerText");
        UpdateStats();
        await RunSpellCheckDebounced();
    }

    private System.Threading.Timer? _debounceTimer;
    private readonly string _editorId = "spell-editor";

    private async Task RunSpellCheckDebounced()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ => 
        {
            await InvokeAsync(async () => 
            {
                var textSnippet = await JSRuntime.InvokeAsync<string>("eval", $"document.getElementById('{_editorId}').innerText");
                var words = textSnippet.Split(new[] { ' ', '\n', '\r', '\t', '.', ',', '!', '?', '(', ')', '[', ']', '{', '}' }, StringSplitOptions.RemoveEmptyEntries);
                var misspelled = words.Where(w => !SpellCheckService.IsWordCorrect(w)).Distinct().ToList();
                
                await JSRuntime.InvokeVoidAsync("spellCheck.updateHighlights", _editorId, misspelled);
            });
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private void UpdateStats()
    {
        _charCount = _currentText.Length;
        _wordCount = _currentText.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private void ClearText()
    {
        _currentText = "";
        _wordCount = 0;
        _charCount = 0;
        _suggestions.Clear();
        _showPopup = false;
        JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{_editorId}').innerText = ''");
        JSRuntime.InvokeVoidAsync("spellCheck.updateHighlights", _editorId, new List<string>());
    }

    private async Task ExportText()
    {
        var text = await JSRuntime.InvokeAsync<string>("eval", $"document.getElementById('{_editorId}').innerText");
        await JSRuntime.InvokeVoidAsync("spellCheck.downloadText", "corrected_text.txt", text);
    }

    private async Task ApplySuggestion(string suggestion)
    {
        await JSRuntime.InvokeVoidAsync("spellCheck.replaceWord", _editorId, _selectedWord, suggestion);
        _showPopup = false;
        _suggestions.Clear();
        
        _currentText = await JSRuntime.InvokeAsync<string>("eval", $"document.getElementById('{_editorId}').innerText");
        UpdateStats();
        await RunSpellCheckDebounced();
    }
}
